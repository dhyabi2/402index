# Server
PORT=3402
NODE_ENV=development

# Aggregators
BAZAAR_POLL_INTERVAL_MS=3600000
BAZAAR_FULL_PASS_TIMEOUT_HOURS=24
SATRING_ENABLED=false
# L402APPS_POLL_INTERVAL_MS=86400000
# SPONGE_POLL_INTERVAL_MS=86400000
# L402DIR_POLL_INTERVAL_MS=3600000
# MPP_POLL_INTERVAL_MS=3600000
# MPPSCAN_POLL_INTERVAL_MS=86400000

# Health checks
HEALTH_CHECK_INTERVAL_MS=900000
# Each sweep stops starting checks after this budget (ms) and runs this many workers.
HEALTH_SWEEP_BUDGET_MS=3000000
HEALTH_SWEEP_CONCURRENCY=32
# Host quarantine (src/health/quarantine.js). false = count rows on quarantined hosts again.
QUARANTINE_ENABLED=true

# Registration
# PROBE_INTER_DELAY_MS=500
# REGISTER_RATE_LIMIT=50
# CLAIM_RATE_LIMIT=10

# L402 Rate Limiting
L402_ENABLED=false
L402_GATEWAY=none          # none | mock | partner
L402_PRICE_SATS=500
L402_DURATION_HOURS=24
# Retry-After (seconds) sent with the 503 when the payment rail cannot issue an invoice.
# Default 3600. Raise it when the outage is known to be long-running.
# L402_UNAVAILABLE_RETRY_AFTER_SECONDS=3600
# QUERY_RATE_LIMIT_PER_MIN=30
# QUERY_RATE_LIMIT_PER_HOUR=500

# Partner gateway (optional private L402 provider integration)
PARTNER_GATEWAY_URL=http://partner.railway.internal:8402
PARTNER_GATEWAY_API_KEY=
PARTNER_GATEWAY_SECRET=

# Admin
# ADMIN_SECRET=
# DIGEST_API_KEY=

# Notifications (optional — email on new service registration)
# NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM=402index <notifications@402index.io>
# RESEND_API_KEY=

# Nostr publishing (optional — publishes NIP-99 events on service changes)
# NOSTR_PRIVATE_KEY=hex_private_key_here
# NOSTR_RELAY_URLS=wss://relay.damus.io,wss://nos.lol

# Embeddings (optional — semantic search via OpenAI)
# OPENAI_API_KEY=

# Analytics (optional)
# GOOGLE_SITE_VERIFICATION=
# PLAUSIBLE_DOMAIN=

# Database
DB_PATH=data/402index.db
